rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    // ครู = เข้าสู่ระบบด้วย Google (ไม่ใช่ anonymous)
    function isTeacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // ผู้ดูแลสื่อ: แก้อีเมลให้ตรงกับ ADMIN_EMAILS ใน public/firebase-config.js
    function isAdmin()   { return isTeacher() && request.auth.token.email in ['krusossocial5344@gmail.com']; }

    // ห้องเรียน: rooms/{รหัส 5 ตัว}
    match /rooms/{code} {
      allow read: if true;
      allow create: if isTeacher()
        && code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['school', 'cls', 'teacher', 'owner', 'created'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.school is string && request.resource.data.school.size() <= 60
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 30
        && request.resource.data.teacher is string && request.resource.data.teacher.size() <= 40;
      allow update: if false;
      allow delete: if isTeacher() && (resource.data.owner == request.auth.uid || isAdmin());

      // คะแนนผู้เล่น/กลุ่ม: rooms/{code}/players/{uid}
      match /players/{pid} {
        allow read: if true;
        allow create, update: if signedIn()
          && pid == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.mode in ['solo', 'group']
          && request.resource.data.score is int
          && request.resource.data.score >= 0 && request.resource.data.score <= 3000;
        allow delete: if signedIn() && (
          pid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(code)).data.owner == request.auth.uid
          || isAdmin());
      }
    }
  }
}
